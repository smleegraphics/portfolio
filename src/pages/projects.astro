---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');

const sortedProjects = allProjects
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Projects | Sam Lee" description="Technical tools, procedural systems, 3D art, and traditional art.">
  <section class="container py-12 md:py-16">
    <header class="mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">Projects</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 whitespace-nowrap">
        Personal projects spanning procedural tooling, 3D character and environment art, and traditional artwork.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          thumbnail={project.data.thumbnail}
          href={`/projects/${project.slug}`}
          tags={project.data.tags}
        />
      ))}
      <ProjectCard
        title="Sketchbook"
        description="My personal explorations in digital art and on paper. I'm most fascinated by drawing figures, and studying color and light."
        thumbnail="/images/art/2D%20art/Digital%20Art/flower_girl.PNG"
        href="/art/sketchbook"
        tags={['digital', 'traditional']}
      />
    </div>
  </section>
</BaseLayout>

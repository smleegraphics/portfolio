---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LavaLampBackground from '../components/LavaLampBackground.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Sam Lee | Creative Developer & 3D Artist">
  <!-- Hero Section -->
  <section class="relative w-full min-h-screen bg-white dark:bg-gray-950">
    <!-- Lava lamp background - blobs that merge and flow -->
    <LavaLampBackground />

    <!-- Decorative blobs (absolute, full width) -->
    <div class="blob blob-purple w-72 h-72 -top-20 -right-20 opacity-20"></div>
    <div class="blob blob-pink w-64 h-64 top-40 -left-32 opacity-15" style="animation-delay: 2s;"></div>

    <!-- Centered content container -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 pt-12 pb-20 md:pt-16 md:pb-32 flex flex-col-reverse lg:flex-row items-center gap-12 lg:gap-16">

      <!-- Text Column -->
      <div class="max-w-2xl relative">
        <h1 class="text-4xl md:text-5xl lg:text-5xl font-display font-bold text-gray-900 dark:text-gray-100 leading-tight fade-in" style="animation-delay: 0.1s">
          Hi, I'm <span class="gradient-text">Sam Lee</span>
          <span class="inline-block animate-float" style="animation-delay: 0.5s;">✨</span>
        </h1>

        <p class="mt-2 text-3xl md:text-4xl lg:text-4xl font-display font-bold text-gray-400 dark:text-gray-500 fade-in" style="animation-delay: 0.15s">
          Technical Artist & Creative Engineer
        </p>

        <p class="mt-6 text-lg md:text-xl text-gray-600 dark:text-gray-400 fade-in" style="animation-delay: 0.2s">
          Crafting tools and experiences that bridge art and technology, with a passion for learning.
        </p>

        <div class="mt-8 flex flex-wrap gap-4 fade-in" style="animation-delay: 0.25s">
          <a href="/projects" class="btn-primary group">
            <span>View My Work</span>
            <svg class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="/about" class="btn-secondary">
            Get to Know Me
          </a>
        </div>
      </div>

      <!-- Headshot Column -->
      <div class="flex-shrink-0 fade-in relative" style="animation-delay: 0.1s">
        <div id="headshot-container" class="relative w-[23rem] h-[30rem] md:w-[28rem] md:h-[34rem] lg:w-[30rem] lg:h-[39rem]">

          <!-- Soft glow behind -->
          <!-- <div class="absolute -inset-20 bg-gradient-to-br from-accent/20 via-purple-200/30 to-pink-200/20 blur-[80px] opacity-100"></div> -->

          <!-- Bean-shaped mask -->
          <div class="absolute left-0 right-0 bottom-0 h-[60%] overflow-hidden shadow-lg"
     style="border-radius: 75% 35% 65% 50% / 65% 70% 55% 50%; transform-origin: center;">

            <img
              src="/images/headshot.jpg"
              alt=""
              class="absolute left-0 w-full object-cover"
              style="height: 166.67%; top: -66.67%; object-position: 30% 20%;"
            />
          </div>

          <!-- Transparent overlay on top -->
          <img
            src="/images/headshot-transparent.png"
            alt="Sam Lee"
            class="absolute inset-0 w-full h-full object-cover drop-shadow-2xl z-10"
            style="object-position: 30% 20%;"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Work -->
  <section class="container pb-20">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-display font-bold text-gray-900 dark:text-gray-100">Featured Work</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Work Experience: Meta -->
      <div class="fade-in opacity-0" style="animation-delay: 0.1s">
        <a href="/work-experience/meta" class="group block card-playful">
          <div class="aspect-[4/3] overflow-hidden relative">
            <img
              src="/images/work-experiences/meta/end-of-year-recap-hzos-events-tech-art-team-meta-reality-labs-google-docs.png"
              alt="Meta"
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-accent/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <span class="absolute top-3 left-3 inline-flex items-center gap-1 px-2.5 py-1 bg-white/90 dark:bg-gray-900/90 text-xs font-medium text-gray-700 dark:text-gray-300 rounded-full backdrop-blur-sm">
              <img src="/images/logos/meta-logo.png" alt="" class="w-3.5 h-3.5 object-contain" />
              Meta
            </span>
          </div>
          <div class="p-5">
            <h3 class="font-display font-semibold text-gray-900 dark:text-gray-100 group-hover:text-accent transition-colors duration-200">Horizon Home Switchable Vistas</h3>
            <p class="mt-1.5 text-sm text-gray-600 dark:text-gray-400 line-clamp-2">High-fidelity VR environments that users can seamlessly switch between as their Quest home space.</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {['unreal', 'python', 'vr'].map((tag) => (
                <span class="px-2.5 py-1 bg-lavender-50 dark:bg-accent/10 text-accent-dark dark:text-accent-light text-xs font-medium rounded-full transition-colors duration-200 group-hover:bg-lavender-100 dark:group-hover:bg-accent/20">{tag}</span>
              ))}
            </div>
          </div>
        </a>
      </div>

      <!-- Work Experience: Applied Intuition -->
      <div class="fade-in opacity-0" style="animation-delay: 0.2s">
        <a href="/work-experience/applied-intuition" class="group block card-playful">
          <div class="aspect-[4/3] overflow-hidden relative">
            <img
              src="/images/work-experiences/applied%20intuition/MetaTechnicalArtistPresentation-ezgif.com-crop.gif"
              alt="Applied Intuition"
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-accent/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <span class="absolute top-3 left-3 inline-flex items-center gap-1 px-2.5 py-1 bg-white/90 dark:bg-gray-900/90 text-xs font-medium text-gray-700 dark:text-gray-300 rounded-full backdrop-blur-sm">
              <img src="/images/logos/applied_intuition_inc_logo.jpeg" alt="" class="w-3.5 h-3.5 object-contain rounded-sm" />
              Applied Intuition
            </span>
            <span class="absolute top-3 right-3 inline-flex items-center gap-1 px-2.5 py-1 bg-white/90 dark:bg-gray-900/90 text-xs font-medium text-gray-500 dark:text-gray-400 rounded-full backdrop-blur-sm">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              Protected
            </span>
          </div>
          <div class="p-5">
            <h3 class="font-display font-semibold text-gray-900 dark:text-gray-100 group-hover:text-accent transition-colors duration-200">Material Editing System</h3>
            <p class="mt-1.5 text-sm text-gray-600 dark:text-gray-400 line-clamp-2">Full-stack tool for customizing road surfaces and material properties in AV simulation environments.</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {['unreal', 'c++', 'react'].map((tag) => (
                <span class="px-2.5 py-1 bg-lavender-50 dark:bg-accent/10 text-accent-dark dark:text-accent-light text-xs font-medium rounded-full transition-colors duration-200 group-hover:bg-lavender-100 dark:group-hover:bg-accent/20">{tag}</span>
              ))}
            </div>
          </div>
        </a>
      </div>

      <!-- Featured Projects -->
      {featuredProjects.slice(0, 1).map((project, index) => (
        <div class="fade-in opacity-0" style={`animation-delay: ${0.3 + index * 0.1}s`}>
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            thumbnail={project.data.thumbnail}
            href={`/projects/${project.slug}`}
            tags={project.data.tags}
          />
        </div>
      ))}
    </div>
  </section>

</BaseLayout>
